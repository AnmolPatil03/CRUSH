# Copy this file to .env (same folder) and edit the copy.
# Real environment variables take precedence over .env.

# Folder that holds uploads/ compressed/ decompressed/
CRUSH_STORAGE=storage

# JPEG XL tools: a name on PATH or a full path, e.g. C:\tools\jxl\bin\cjxl.exe
CRUSH_CJXL=cjxl
CRUSH_DJXL=djxl

# Parallel worker processes for large multi-stream files
CRUSH_WORKERS=4
# Jobs smaller than this many bytes run in-process
CRUSH_PARALLEL_THRESHOLD=2097152
CRUSH_MAX_UPLOAD_MB=200
CRUSH_HOST=127.0.0.1
CRUSH_PORT=8000
